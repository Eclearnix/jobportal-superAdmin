# Public Google Identity Services web client ID (same OAuth client as the backend).
VITE_GOOGLE_CLIENT_ID=

# Frontend API origin, without a trailing slash. Leave empty for the local Vite proxy
# or same-origin production deployment.
VITE_API_BASE_URL=

# API server
PORT=4000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
PRIMARY_ADMIN_EMAIL=
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ADMIN_CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Optional interview email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
