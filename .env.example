# Public Google Identity Services web client ID (same OAuth client as the backend).
VITE_GOOGLE_CLIENT_ID=

# Frontend API origin, without a trailing slash. Leave empty for the local Vite proxy
# or same-origin production deployment.
VITE_API_BASE_URL=

# API server
PORT=4000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
# Initial primary administrator email. The database designation takes precedence after a manual transfer.
PRIMARY_ADMIN_EMAIL=deepakrg23it@srishakthi.ac.in
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ADMIN_CLIENT_ORIGIN=http://localhost:5173,https://jobportal-super-admin.vercel.app
TRUST_PROXY=false

# Gmail SMTP (use a Google App Password, not your Gmail account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=eclearnix.jobs@gmail.com
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER. For Gmail, use the same address unless a verified alias is configured.
SMTP_FROM=
